# MongoDB连接字符串
MONGODB_URI=mongodb://localhost:27017/vibe-kanban

# NextAuth.js配置
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production

# MCP API Key (用于Trae IDE连接MCP服务)
MCP_API_KEY=your-mcp-api-key-change-this-in-production

# 可选：如果使用外部MongoDB服务
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vibe-kanban
